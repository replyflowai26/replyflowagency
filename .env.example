# Public Supabase project configuration (no real values in this file).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute public origin of the deployed site (e.g. https://replyflowagency.com).
# Used to build workspace invitation links. Falls back to VERCEL_URL then
# localhost when unset, so set this in production to avoid broken invite links.
NEXT_PUBLIC_SITE_URL=

# Server-only key. Keep this secret out of client code and use a real value only in a local or deployed environment.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only n8n integration (used by dispatch and recovery reconciliation).
# N8N_BASE_URL must point at the n8n instance; N8N_API_KEY is only needed for
# the read-only recovery reconciliation endpoint (never used for dispatch).
N8N_BASE_URL=
N8N_API_KEY=

# Server-only shared secret used to HMAC-sign the ReplyFlow n8n callback
# request bodies. Must match the value n8n's callback node uses when it signs
# the callback it sends to /api/automation/callback. Never expose to clients.
REPLYFLOW_CALLBACK_SECRET=

# Server-only secrets for the internal automation cron endpoints
# (/api/internal/automation/recovery and /api/internal/automation/retention).
INTERNAL_AUTOMATION_SECRET=
CRON_SECRET=

# Server-only shared secret for the inbound lead-intake webhook
# (POST /api/automation/leads). A trusted sender HMAC-SHA256 signs the raw body
# with this secret and sends it in the `x-replyflow-signature` header. When it is
# unset the endpoint refuses to operate (503). Never expose to clients.
REPLYFLOW_LEAD_INTAKE_SECRET=

# Server-only outbound CRM integration for lead delivery. The URL is an
# absolute https endpoint owned by the customer (http is allowed only for
# loopback during local development); the secret HMAC-signs each delivery.
# When either value is unset the run fails honestly rather than faking delivery.
REPLYFLOW_CRM_WEBHOOK_URL=
REPLYFLOW_CRM_WEBHOOK_SECRET=

# Server-only AI model configuration for the Operations Assistant agent.
# The adapter speaks the OpenAI-compatible chat-completions format, so any
# compatible provider works. With NONE of these set the agent uses its
# deterministic planner (no LLM). A PARTIAL configuration fails honestly.
# REPLYFLOW_AI_BASE_URL must be an absolute https URL (http only for loopback).
# REPLYFLOW_AI_API_KEY is sent only as an Authorization header and is never
# logged or placed in a prompt.
REPLYFLOW_AI_API_KEY=
REPLYFLOW_AI_BASE_URL=
REPLYFLOW_AI_MODEL=
# Optional tuning (defaults: timeout 20000 ms, max retries 2).
REPLYFLOW_AI_TIMEOUT_MS=
REPLYFLOW_AI_MAX_RETRIES=
